{
  "name": "progettodighe-phpbb-theme",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tema phpBB di ProgettoDighe",
  "scripts": {
    "env:up": "podman-compose -f test/compose.yml up --build -d && test/bin/install.sh",
    "env:down": "podman-compose -f test/compose.yml down -v",
    "test:e2e": "playwright test",
    "test:e2e:dev": "PD_BASE_URL=https://dev.progettodighe.it/forum playwright test",
    "test:e2e:prod": "PD_BASE_URL=https://www.progettodighe.it/forum playwright test",
    "test:matrix": "test/bin/matrix.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
